        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROM}"},
      "description": "应用上报的总成本 (USD)。粒度由 Prometheus 决定，按实例 + env=production。",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "decimals": 2,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 50},
              {"color": "red", "value": 500}
            ]
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {"expr": "yuxin_api_cost_usd_total", "legendFormat": "总成本 USD", "refId": "A"}
      ],
      "title": "总成本 (USD, Prom 总量)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROM}"},
      "description": "请求成功率 = success / (success + failed)。Prom 指标 yuxin_api_requests_total{type=...}",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 95},
              {"color": "green", "value": 99}
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "id": 2,
      "options": {
        "minVizHeight": 75,
        "minVizWidth": 75,
        "namePlacement": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "expr": "sum(rate(yuxin_api_requests_total{type=\"success\"}[5m])) / clamp_min(sum(rate(yuxin_api_requests_total[5m])), 1e-9) * 100",
          "legendFormat": "成功率",
          "refId": "A"
        }
      ],
      "title": "请求成功率 (Prom)",
      "type": "gauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROM}"},
      "description": "缓存命中率 = hit / (hit + miss)。yuxin_api_cache_total",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 30},
              {"color": "green", "value": 60}
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "id": 3,
      "options": {
        "minVizHeight": 75,
        "minVizWidth": 75,
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "expr": "sum(rate(yuxin_api_cache_total{type=\"hit\"}[5m])) / clamp_min(sum(rate(yuxin_api_cache_total[5m])), 1e-9) * 100",
          "legendFormat": "缓存命中率",
          "refId": "A"
        }
      ],
      "title": "缓存命中率 (Prom)",
      "type": "gauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROM}"},
      "description": "请求速率 (成功/失败分曲线)",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "req/s",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {"legend": false, "tooltip": false, "viz": false},
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {"type": "linear"},
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {"group": "A", "mode": "none"},
            "thresholdsStyle": {"mode": "off"}
          },
          "unit": "reqps"
        }
      },
      "gridPos": {"h": 4, "w": 12, "x": 12, "y": 0},
      "id": 4,
      "options": {
        "legend": {"calcs": ["mean", "max"], "displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {"expr": "sum(rate(yuxin_api_requests_total{type=\"success\"}[5m]))", "legendFormat": "success", "refId": "A"},
        {"expr": "sum(rate(yuxin_api_requests_total{type=\"failed\"}[5m]))", "legendFormat": "failed", "refId": "B"}
      ],
      "title": "请求速率 (req/s, Prom)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "grafana-clickhouse-datasource", "uid": "${DS_CH}"},
      "description": "每日成本按模型拆分。type=2 为真实消费 (LogTypeConsume)。quota 单位换算 USD: 1 quota = 0.002 / 1K tokens (见 common/constants.go QuotaPerUnit=500000)。",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisCenteredZero": false,
            "axisLabel": "USD",
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "hideFrom": {"legend": false, "tooltip": false, "viz": false},
            "lineWidth": 2,
            "spanNulls": false,
            "stacking": {"group": "A", "mode": "normal"}
          },
          "unit": "currencyUSD"
        }
      },
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 4},
      "id": 5,
      "options": {
        "legend": {"calcs": ["sum"], "displayMode": "table", "placement": "right", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "grafana-clickhouse-datasource", "uid": "${DS_CH}"},
          "rawSql": "SELECT toStartOfDay(toDateTime(created_at)) AS time, model_name, sum(quota) * 0.002 AS cost_usd FROM new_api_logs.logs WHERE type = 2 AND model_name != '' AND $__timeFilter(toDateTime(created_at)) GROUP BY time, model_name ORDER BY time ASC",
          "format": 2,
          "refId": "A"
        }
      ],
      "title": "每日成本 (USD, 按模型)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "grafana-clickhouse-datasource", "uid": "${DS_CH}"},
      "description": "成本 TOP 模型 (按累计 quota 排序)",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "decimals": 4,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
          "unit": "currencyUSD"
        }
      },
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 4},
      "id": 6,
      "options": {
        "footer": {"fields": "", "reducer": ["sum"], "show": true},
        "showFieldIcons": false
      },
      "targets": [
        {
          "datasource": {"type": "grafana-clickhouse-datasource", "uid": "${DS_CH}"},
          "rawSql": "SELECT model_name, sum(quota) AS q_total, sum(quota) * 0.002 AS cost_usd, sum(prompt_tokens) AS pt_total, sum(completion_tokens) AS ct_total, count() AS req FROM new_api_logs.logs WHERE type = 2 AND model_name != '' AND $__timeFilter(toDateTime(created_at)) GROUP BY model_name ORDER BY q_total DESC LIMIT 20",
          "format": 1,
          "refId": "A"
        }
      ],
      "title": "成本 TOP 模型",
      "type": "table"
    },
    {
      "datasource": {"type": "grafana-clickhouse-datasource", "uid": "${DS_CH}"},
      "description": "渠道调用量与成本 (按 channel_id 分组; channel_id 是数字, 渠道名映射需在 ClickHouse 端另建维表; 当前日志表不含渠道名字段)",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "decimals": 4,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        }
      },
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 13},
      "id": 7,
      "options": {
        "footer": {"fields": "", "reducer": ["sum"], "show": true},
        "showFieldIcons": false
      },
      "targets": [
        {
          "datasource": {"type": "grafana-clickhouse-datasource", "uid": "${DS_CH}"},
          "rawSql": "SELECT toString(channel_id) AS channel, count() AS req, sum(quota) AS q_total, sum(quota) * 0.002 AS cost_usd FROM new_api_logs.logs WHERE type = 2 AND channel_id > 0 AND $__timeFilter(toDateTime(created_at)) GROUP BY channel ORDER BY req DESC LIMIT 50",
          "format": 1,
          "refId": "A"
        }
      ],
      "title": "渠道调用量 & 成本 (按 channel_id)",
      "type": "table"
    },
    {
      "datasource": {"type": "grafana-clickhouse-datasource", "uid": "${DS_CH}"},
      "description": "延迟 P50/P95/P99 按模型。use_time 为整数秒, 粒度较粗 (建议后续在网关侧接入 histogram)。",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "decimals": 1,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
          "unit": "s"
        }
      },
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 13},
      "id": 8,
      "options": {
        "footer": {"fields": "", "reducer": ["sum"], "show": true},
        "showFieldIcons": false
      },
      "targets": [
        {
          "datasource": {"type": "grafana-clickhouse-datasource", "uid": "${DS_CH}"},
          "rawSql": "SELECT model_name, quantile(0.5)(use_time) AS p50_s, quantile(0.95)(use_time) AS p95_s, quantile(0.99)(use_time) AS p99_s, avg(use_time) AS avg_s, count() AS req FROM new_api_logs.logs WHERE type = 2 AND model_name != '' AND use_time > 0 AND $__timeFilter(toDateTime(created_at)) GROUP BY model_name ORDER BY req DESC LIMIT 20",
          "format": 1,
          "refId": "A"
        }
      ],
      "title": "延迟分位 (秒, 按模型)",
      "type": "table"
    },
    {
      "datasource": {"type": "grafana-clickhouse-datasource", "uid": "${DS_CH}"},
      "description": "渠道错误率: type=2 为消费成功, type=5 为错误 (LogTypeError)",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 5}
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 22},
      "id": 9,
      "options": {
        "footer": {"fields": "", "reducer": ["sum"], "show": true},
        "showFieldIcons": false
      },
      "targets": [
        {
          "datasource": {"type": "grafana-clickhouse-datasource", "uid": "${DS_CH}"},
          "rawSql": "SELECT toString(channel_id) AS channel, countIf(type = 2) AS success, countIf(type = 5) AS errors, countIf(type IN (2, 5)) AS total, round(countIf(type = 5) / countIf(type IN (2, 5)) * 100, 2) AS err_rate_pct FROM new_api_logs.logs WHERE channel_id > 0 AND $__timeFilter(toDateTime(created_at)) GROUP BY channel ORDER BY total DESC LIMIT 50",
          "format": 1,
          "refId": "A"
        }
      ],
      "title": "渠道错误率矩阵",
      "type": "table"
    },
    {
      "datasource": {"type": "grafana-clickhouse-datasource", "uid": "${DS_CH}"},
      "description": "每日错误数趋势 by 渠道 (LogTypeError=5)",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisCenteredZero": false,
            "axisLabel": "errors/day",
            "drawStyle": "bars",
            "fillOpacity": 60,
            "gradientMode": "none",
            "lineWidth": 1,
            "stacking": {"group": "A", "mode": "normal"}
          },
          "unit": "short"
        }
      },
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 22},
      "id": 10,
      "options": {
        "legend": {"calcs": ["sum"], "displayMode": "table", "placement": "right", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "grafana-clickhouse-datasource", "uid": "${DS_CH}"},
          "rawSql": "SELECT toStartOfDay(toDateTime(created_at)) AS time, toString(channel_id) AS channel, count() AS errors FROM new_api_logs.logs WHERE type = 5 AND channel_id > 0 AND $__timeFilter(toDateTime(created_at)) GROUP BY time, channel ORDER BY time ASC",
          "format": 2,
          "refId": "A"
        }
      ],
      "title": "每日错误数 (按渠道)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "grafana-clickhouse-datasource", "uid": "${DS_CH}"},
      "description": "每日 P95 延迟趋势 by 模型",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisLabel": "秒",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "stacking": {"group": "A", "mode": "none"}
          },
          "unit": "s"
        }
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 31},
      "id": 11,
      "options": {
        "legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "right", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "grafana-clickhouse-datasource", "uid": "${DS_CH}"},
          "rawSql": "SELECT toStartOfDay(toDateTime(created_at)) AS time, model_name, quantile(0.95)(use_time) AS p95_s FROM new_api_logs.logs WHERE type = 2 AND model_name != '' AND use_time > 0 AND $__timeFilter(toDateTime(created_at)) GROUP BY time, model_name ORDER BY time ASC",
          "format": 2,
          "refId": "A"
        }
      ],
      "title": "每日 P95 延迟趋势 (按模型)",
      "type": "timeseries"
    }
  ],
